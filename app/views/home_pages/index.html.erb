<div class="home-page">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Transform Your Business with Innovative Solutions</h1>
      <p class="hero-subtitle">Streamline operations, boost productivity, and drive growth with our cutting-edge platform designed for modern enterprises.</p>
      <div class="cta-buttons">
        <a href="#" class="btn btn-primary">Get Started</a>
        <a href="#" class="btn btn-secondary">Learn More</a>
      </div>
    </div>
  </section>
<%= @user.last_name %>
  <!-- Features Section -->
  <section class="features">
    <div class="container">
      <h2 class="section-title">Why Choose Our Platform</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">🚀</div>
          <h3>Lightning Fast</h3>
          <p>Optimized performance that keeps your business running at peak efficiency.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Enterprise Security</h3>
          <p>Bank-grade security protocols to protect your valuable data and assets.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3>Advanced Analytics</h3>
          <p>Real-time insights and comprehensive reporting for data-driven decisions.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Seamless Integration</h3>
          <p>Connect effortlessly with your existing tools and workflows.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-number">500+</div>
          <div class="stat-label">Enterprise Clients</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">99.9%</div>
          <div class="stat-label">Uptime Guarantee</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Expert Support</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">10M+</div>
          <div class="stat-label">Transactions Processed</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Transform Your Business?</h2>
      <p>Join hundreds of enterprises already leveraging our platform for success.</p>
      <a href="#" class="btn btn-primary btn-large">Start Your Free Trial</a>
    </div>
  </section>

  <!-- React Integration Points -->
